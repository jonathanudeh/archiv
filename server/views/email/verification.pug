extends baseEmail

block content
  // CONTENT
  p Hi #{firstname},
  p Welcome to Archiv, we're glad to have you.
  p To get the best experience out of Archiv, please verify your email address by clicking the button below: 
  table.btn.btn-primary(role='presentation', border='0', cellpadding='0', cellspacing='0')
    tbody
      tr
        td(align='left')
          table(role='presentation', border='0', cellpadding='0', cellspacing='0')
            tbody
              tr
                td
                  a(href=`${url}`, target='_blank') Verify Email
  p if you did not create an account, no further action is required.
  p Best regards,
  p - Archiv Team